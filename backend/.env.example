# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/cloudvault

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your-cloudvault-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRES_IN=900

# User Storage Quotas (Default 1 GB in bytes)
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
